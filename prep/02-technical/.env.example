# ---------- api (FastAPI) ----------
APP_ENV=demo                       # demo | pilot | production
TZ=Asia/Ho_Chi_Minh
DATABASE_URL=sqlite+aiosqlite:///./data/alodi.db
RECORDINGS_DIR=./data/recordings
RECORDING_TTL_DAYS=30

# Demo clock: 1 = real time; 600 = 60 minutes pass in 6 seconds
DEMO_CLOCK_SPEED=600
DEMO_START=2026-10-31T06:28:00+07:00

# Policy guard
CALL_WINDOW_START=08:00
CALL_WINDOW_END=20:30
UNDO_WINDOW_MIN=2
CALL1_AFTER_MIN=60
CALL2_AFTER_MIN=120
MAX_CALLS_PER_CYCLE=2
MAX_REDELIVERIES=2
RESCHEDULE_HORIZON_DAYS=5
AUTO_APPLY_CONFIDENCE=0.85
ROUTE_CUTOFF=08:00

# Models
OPENAI_API_KEY=
OPENAI_MODEL=                      # the model provided on competition day
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
ASSEMBLYAI_API_KEY=

# Live demo (three devices)
PUBLIC_DOMAIN=demo.alodi.app        # PLACEHOLDER — use a domain you own; Caddy issues HTTPS for it (mic needs HTTPS on iOS)
DEMO_SCENARIO=A_main
MOCK_PACK_DIR=/pack                 # prep/02-technical/mock-data mounted read-only
AUTO_BUYER=false
OFFLINE_MODE=false

# CORS / web
WEB_ORIGIN=https://demo.alodi.app

# ---------- web (Next.js) ----------
NEXT_PUBLIC_API_URL=https://demo.alodi.app/api
NEXT_PUBLIC_WS_URL=wss://demo.alodi.app/ws
NEXT_PUBLIC_RELAY_URL=              # fast path only, e.g. wss://demo.alodi.app/relay
