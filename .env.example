# Integrated local backend. Never put provider secrets in NEXT_PUBLIC_*.
APP_ENV=demo
TZ=Asia/Ho_Chi_Minh
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Relative paths always resolve from the repository root.
DATABASE_URL=sqlite+aiosqlite:///./data/alodi.db
MOCK_PACK_DIR=./prep/02-technical/mock-data
RECORDINGS_DIR=./data/recordings
RECORDING_TTL_DAYS=30

AI_MODE=stub
DEMO_START=2026-10-31T06:28:00+07:00
DEMO_CLOCK_SPEED=600
DEMO_SCENARIO=A_main
AUTO_BUYER=false
OFFLINE_MODE=false

CALL_WINDOW_START=08:00
CALL_WINDOW_END=20:30
UNDO_WINDOW_MIN=2
CALL1_AFTER_MIN=60
CALL2_AFTER_MIN=120
MAX_CALLS_PER_CYCLE=2
MAX_REDELIVERIES=2
RESCHEDULE_HORIZON_DAYS=5
AUTO_APPLY_CONFIDENCE=0.85
ROUTE_CUTOFF=08:00

# GPT services. AI_MODE=stub is synthetic; AI_MODE=live requires OPENAI_API_KEY.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
OPENAI_REASONING_EFFORT=none
VOICE_PROVIDER=gpt_live
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_VOICE=marin
OPENAI_MEMO_MODEL=gpt-transcribe
BUYER_LANGUAGE=vi
CALL_MAX_DURATION_SECONDS=180
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AI_REQUEST_TIMEOUT_SECONDS=30
