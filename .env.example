# Part 1: repository-root settings. Never put provider secrets in NEXT_PUBLIC_*.
APP_ENV=demo
TZ=Asia/Ho_Chi_Minh
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000

# Relative paths always resolve from the repository root.
DATABASE_URL=sqlite+aiosqlite:///./data/alodi.db
MOCK_PACK_DIR=./prep/02-technical/mock-data
RECORDINGS_DIR=./data/recordings
RECORDING_TTL_DAYS=30

AI_MODE=stub
DEMO_START=2026-10-31T06:28:00+07:00
DEMO_CLOCK_SPEED=600
DEMO_SCENARIO=A_main
AUTO_BUYER=false
OFFLINE_MODE=false

CALL_WINDOW_START=08:00
CALL_WINDOW_END=20:30
UNDO_WINDOW_MIN=2
CALL1_AFTER_MIN=60
CALL2_AFTER_MIN=120
MAX_CALLS_PER_CYCLE=2
MAX_REDELIVERIES=2
RESCHEDULE_HORIZON_DAYS=5
AUTO_APPLY_CONFIDENCE=0.85
ROUTE_CUTOFF=08:00

# Optional Part 2 configuration. Preserve existing local values when merging.
# Live providers are not implemented in this foundation increment.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=none
ASSEMBLY_API_KEY=
ASSEMBLYAI_MEMO_MODEL=universal-3-5-pro
VOICE_PROVIDER=openai_realtime
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
BUYER_LANGUAGE=vi
CALL_MAX_DURATION_SECONDS=90
FFMPEG_PATH=ffmpeg
AI_REQUEST_TIMEOUT_SECONDS=30
